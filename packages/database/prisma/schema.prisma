// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash   String
  role           Role            @default(STORE_EMPLOYEE)
  /// Store assignment (Section 2). Required for STORE_EMPLOYEE, null for other roles.
  storeId        String?
  store          Store?          @relation(fields: [storeId], references: [id])
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  createdSales   Sale[]          @relation("SaleCreatedBy")
  confirmedSales Sale[]          @relation("SaleConfirmedBy")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// Store master data (MD-03). `code` is unique; the list is ordered newest-first.
model Store {
  id                String                    @id @default(cuid())
  code              String                    @unique
  name              String
  employees         User[]
  reorderThresholds ProductReorderThreshold[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  sales             Sale[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

/// Supplier master data (MD-03). `code` is unique; contact details are optional.
/// The list is ordered newest-first.
model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Product master data (MD-01, MD-02). `sku` is unique across the organization and
/// immutable once referenced by a transaction. `sellingPrice` is money (two decimals).
/// Deactivation keeps the product searchable but blocks it from new documents.
model Product {
  id                String                    @id @default(cuid())
  sku               String                    @unique
  name              String
  category          String
  unit              String
  sellingPrice      Decimal                   @db.Decimal(12, 2)
  isActive          Boolean                   @default(true)
  reorderThresholds ProductReorderThreshold[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  saleLines         SaleLine[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

/// Per-store reorder threshold for a product (MD-01). A product has at most one
/// threshold per store; `threshold` is a non-negative whole number.
model ProductReorderThreshold {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  threshold Int

  @@unique([productId, storeId])
}

enum StockMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
}

/// Current stock per (product, store) (INV-03). Updated only inside the transaction that
/// inserts the matching `StockMovement`, by a conditional UPDATE that refuses to go below
/// zero (INV-04). A CHECK constraint (see the migration) backs the floor at the database.
model StockBalance {
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([productId, storeId])
}

/// Append-only stock ledger (INV-02). One row per stock increase or decrease. Rows are
/// immutable: database triggers (see the migration) reject UPDATE and DELETE.
/// `balanceAfter = balanceBefore + quantityChange`, and is never negative.
model StockMovement {
  id                 String            @id @default(cuid())
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  storeId            String
  store              Store             @relation(fields: [storeId], references: [id])
  quantityChange     Int
  balanceBefore      Int
  balanceAfter       Int
  type               StockMovementType
  /// The document that caused the movement, e.g. type "GOODS_RECEIPT" and its document number.
  sourceDocumentType String
  sourceDocumentId   String
  actorId            String
  actor              User              @relation(fields: [actorId], references: [id])
  createdAt          DateTime          @default(now())

  @@index([productId, storeId, createdAt])
  @@index([createdAt])
}

/// Last number issued per document prefix (Section 4.3). Incremented by a single atomic
/// upsert inside the caller's transaction, so numbers are unique and a rollback gives the
/// number back.
model DocumentSequence {
  prefix    String @id
  lastValue Int
}

/// Audit trail (NFR-03). One immutable row per audited action — who did it, to which
/// source document, and the outcome. Established by the stock-adjustment ticket and
/// reused by PO approvals, goods receipts and sales confirmations. Reads are
/// permission-restricted at the API.
model AuditLog {
  id                 String   @id @default(cuid())
  actorId            String
  actor              User     @relation(fields: [actorId], references: [id])
  /// What happened, e.g. "STOCK_ADJUSTMENT".
  action             String
  /// The document the action concerned, e.g. type "ADJUSTMENT" and its number.
  sourceDocumentType String
  sourceDocumentId   String
  /// "SUCCESS" or "REJECTED".
  outcome            String
  /// Optional human-readable context, e.g. the adjustment reason.
  detail             String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

enum SaleStatus {
  DRAFT
  CONFIRMED
}

/// A sale at one store (SAL-01..SAL-04). A DRAFT never touches stock; confirming it, in
/// one transaction, issues `documentNumber`, decreases stock and appends SALE movements.
/// A CONFIRMED sale is final: no edit, cancel or return in this release.
/// Confirmation is idempotent: the client's `Idempotency-Key` is stored with the sale,
/// unique per actor, so a replay finds the original instead of posting again (SAL-03).
model Sale {
  id             String      @id @default(cuid())
  /// "SAL-000001", issued on confirmation (Section 4.3). Null while a draft.
  documentNumber String?     @unique
  status         SaleStatus  @default(DRAFT)
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  createdById    String
  createdBy      User        @relation("SaleCreatedBy", fields: [createdById], references: [id])
  confirmedById  String?
  confirmedBy    User?       @relation("SaleConfirmedBy", fields: [confirmedById], references: [id])
  /// Sum of the lines, two decimals. Recomputed whenever the lines change.
  total          Decimal     @db.Decimal(12, 2)
  /// The `Idempotency-Key` header of the confirming request. Null while a draft.
  idempotencyKey String?
  confirmedAt    DateTime?
  lines          SaleLine[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([confirmedById, idempotencyKey])
  @@index([storeId, createdAt])
}

/// One product on a sale. `sku`, `productName`, `unit` and `unitPrice` are snapshots
/// taken when the line is saved, so later master-data edits never change the document.
model SaleLine {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  sku            String
  productName    String
  unit           String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  /// Copied from the confirming request, like `Sale.idempotencyKey`.
  idempotencyKey String?
  /// Stock left in the store once this line was posted. Null while a draft.
  balanceAfter   Int?

  @@unique([saleId, productId])
}
